{
    "dataRoles": [
        {
            "displayName": "Category Data",
            "name": "category",
            "kind": "Grouping"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "category": {
                        "min": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "for": {
                        "in": "category"
                    }
                }
            }
        }
    ],
    "supportsEmptyDataView": true,
    "supportsLandingPage": true,
    "privileges": [
        {
            "name": "WebAccess",
            "essential": true,
            "parameters": ["https://*.thecatapi.com", "https://*.thedogapi.com"]
        }
    ],
    "objects": {
        "general":{
            "properties": {
                "description": {
                    "type": {
                        "text": true
                    }
                },
                "dogs": {
                    "type": {
                        "bool": true
                    }
                }
            }
        }
    }
}
